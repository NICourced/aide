CREATE TABLE task (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    prompt TEXT NOT NULL,
    branch TEXT NOT NULL,
    status TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    payload BLOB NOT NULL
);

CREATE INDEX task_status ON task(status);

insert:
INSERT OR REPLACE INTO task(id, title, prompt, branch, status, created_at, payload)
VALUES (?, ?, ?, ?, ?, ?, ?);

byId:
SELECT * FROM task WHERE id = ?;

byStatus:
SELECT * FROM task WHERE status = ? ORDER BY created_at DESC;

/**
 * Незавершённые задачи в порядке постановки — очередь и сырьё восстановления после падения (T-1.1).
 *
 * «Не завершено» выражено отрицанием завершённых статусов, а не перечислением
 * незавершённых: новый незавершённый статус иначе молча выпал бы из очереди.
 */
unfinished:
SELECT * FROM task
WHERE status NOT IN ('REVIEW', 'ACCEPTED', 'REJECTED', 'FAILED')
ORDER BY created_at;

/**
 * Незакрытые задачи: не в терминальном состоянии — включая ожидающие ревью (T-1.19).
 *
 * Отличается от `unfinished`: в очередь берутся задачи без прогона, а снапшоты нужны
 * и задачам на ревью, поэтому отрицание перечисляет только завершённые статусы.
 */
unclosed:
SELECT * FROM task
WHERE status NOT IN ('ACCEPTED', 'REJECTED', 'FAILED')
ORDER BY created_at;

/** Все задачи в порядке постановки — снимок состояния агента (T-1.1). */
all:
SELECT * FROM task ORDER BY created_at;

delete:
DELETE FROM task WHERE id = ?;

count:
SELECT count(*) FROM task;

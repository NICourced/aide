-- Таблица неизменяемых пакетов изменений (T-1.24).
-- Полный объект хранится в payload; индексируемые поля — task_id, status, risk, branch,
-- чтобы можно было искать пакеты задачи и очередь ревью без разбора CBOR.
CREATE TABLE change_packet (
    id TEXT NOT NULL,
    revision INTEGER NOT NULL,
    task_id TEXT NOT NULL,
    status TEXT NOT NULL,
    risk TEXT NOT NULL,
    branch TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    payload BLOB NOT NULL,
    PRIMARY KEY (id, revision)
);

CREATE INDEX change_packet_task ON change_packet(task_id, revision);
CREATE INDEX change_packet_status ON change_packet(status, created_at);

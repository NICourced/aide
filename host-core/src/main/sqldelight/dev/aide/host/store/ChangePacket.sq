CREATE TABLE change_packet (
    id TEXT NOT NULL,
    revision INTEGER NOT NULL,
    task_id TEXT NOT NULL,
    status TEXT NOT NULL,
    risk TEXT NOT NULL,
    branch TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    payload BLOB NOT NULL,
    PRIMARY KEY (id, revision)
);

CREATE INDEX change_packet_task ON change_packet(task_id, revision);
CREATE INDEX change_packet_status ON change_packet(status, created_at);

insert:
INSERT INTO change_packet(id, revision, task_id, status, risk, branch, created_at, payload)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

byIdRevision:
SELECT * FROM change_packet WHERE id = ? AND revision = ?;

byTask:
SELECT * FROM change_packet WHERE task_id = ? ORDER BY revision;

latestRevision:
SELECT coalesce(max(revision), 0) FROM change_packet WHERE id = ?;

all:
SELECT * FROM change_packet ORDER BY created_at, id, revision;

count:
SELECT count(*) FROM change_packet;
